{
	admin off
}

:80 {
	root * /srv
	encode zstd gzip
	# arquivos com hash no nome: cache longo; o resto sempre revalidado
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	@pagina not path /assets/*
	header @pagina Cache-Control "no-cache"

	# SPA: qualquer rota sem arquivo correspondente cai no index.html
	try_files {path} /index.html
	file_server
}
